# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# --- The two partners (fixed partnership) ---
# Partner 1
PARTNER_1_NAME=Mark
PARTNER_1_TELEGRAM_ID=111111111
# Partner 2
PARTNER_2_NAME=Alex
PARTNER_2_TELEGRAM_ID=222222222

# --- OpenRouter / AI ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct
# gpt-4o-mini: reliable extraction, first-party OpenAI (no provider roulette), cheap.
TEXT_MODEL=openai/gpt-4o-mini

# --- Money / currency ---
CURRENCY=PHP
CURRENCY_SYMBOL=₱

# --- Storage ---
# Absolute path inside the container; maps to the persistent volume.
DB_PATH=/app/data/expenses.db

# --- Conversation ---
# Seconds before an unconfirmed draft auto-expires.
DRAFT_TIMEOUT=300
